{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Narrator",
  "version": "0.1.0",
  "identifier": "com.martin.simple-narrator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Simple Narrator",
        "width": 1200,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 18 }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["bin/piper"],
    "resources": {
      "models/piper/*": "models/piper/"
    },
    "macOS": {
      "bundleName": "Simple Narrator",
      "infoPlist": "Info.plist"
    }
  }
}
